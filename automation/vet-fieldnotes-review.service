[Unit]
Description=Read-only local Veterinary Fieldnotes morning review

[Service]
Type=simple
UMask=0077
WorkingDirectory=%h/FieldNotes/app
ExecStart=%h/FieldNotes/app/pipeline/.venv/bin/python -m vet_pipeline.review_server --workspace %h/FieldNotes/data/library --reuse-state
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/FieldNotes/data/library

[Install]
WantedBy=default.target
