[Unit]
Description=Import and process authorized veterinary learning recordings
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
WorkingDirectory=%h/FieldNotes/app
Environment=VET_WORKSPACE=%h/FieldNotes/data/library
EnvironmentFile=-%h/FieldNotes/config/environment
ExecStart=%h/FieldNotes/app/pipeline/.venv/bin/vet-pipeline --config %h/FieldNotes/config/pipeline.toml unattended
TimeoutStartSec=infinity
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/FieldNotes/data/library -%h/FieldNotes/repositories/master
# Recorder mounts and model caches need read access. First cache the chosen model with the owner account.
