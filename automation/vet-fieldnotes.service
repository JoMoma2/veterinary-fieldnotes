[Unit]
Description=Import and process authorized veterinary learning recordings
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
WorkingDirectory=%h/vet-knowledge-library
Environment=VET_WORKSPACE=%h/.local/share/vet-fieldnotes-live
EnvironmentFile=-%h/.config/vet-fieldnotes/environment
ExecStart=%h/vet-knowledge-library/pipeline/.venv/bin/vet-pipeline --config %h/.config/vet-fieldnotes/pipeline.toml unattended
TimeoutStartSec=infinity
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/share/vet-fieldnotes-live -%h/vet-knowledge-master
# Recorder mounts and model caches need read access. First cache the chosen model with the owner account.
