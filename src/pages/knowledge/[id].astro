---
import Layout from '../../layouts/Layout.astro';
import Tags from '../../components/Tags.astro';
import Sources from '../../components/Sources.astro';
import { getLibrary } from '../../lib/library';
import { markdown, dateLabel } from '../../lib/format';
export async function getStaticPaths() {
  const lib = await getLibrary();
  return lib.articles.map((article) => ({ params: { id: article.id }, props: { article, lib } }));
}
const { article: a, lib } = Astro.props;
---

<Layout title={a.title} section="Knowledge library" description={a.summary}>
  <a href="/knowledge/" class="back-link">
    ← Knowledge library
  </a>
  <div class="reading-heading" data-pagefind-body>
    <Tags ids={a.topics} topics={lib.topics} />
    <h1 data-pagefind-meta="title">{a.title}</h1>
    <p class="lead">{a.summary}</p>
    <span class="muted">
      Updated {dateLabel(a.updated)} · {a.sourceDiscussionIds.length} source discussions
    </span>
    <div class="notice">
      {a.origin === 'synthetic'
        ? 'Synthetic educational example. This note demonstrates the library; its case details are fictional.'
        : 'Educational material. Source observations and explanatory material must be interpreted separately.'}
    </div>
    <div class="prose article-body" set:html={markdown(a.body)} />
  </div>
  <div class="reading">
    <Sources ids={a.sourceDiscussionIds} discussions={lib.discussions} shifts={lib.shifts} />
    {a.relatedArticleIds.length > 0 && (
      <section class="panel">
        <h2>Keep exploring</h2>
        {a.relatedArticleIds.map((id) => (
          <a class="related-link" href={`/knowledge/${id}/`}>
            ↗ {lib.articles.find((x) => x.id === id)!.title}
          </a>
        ))}
      </section>
    )}
    <a class="button primary" href={`/study/?topic=${a.topics[0]}`}>
      Study this subject →
    </a>
  </div>
</Layout>
