---
import Layout from '../../layouts/Layout.astro';
import Discussion from '../../components/Discussion.astro';
import { getLibrary } from '../../lib/library';
import { dateLabel, offset } from '../../lib/format';
export async function getStaticPaths() {
  const lib = await getLibrary();
  return lib.shifts.map((shift) => ({ params: { id: shift.id }, props: { shift, lib } }));
}
const { shift: s, lib } = Astro.props;
const ds = lib.discussions.filter((d) => d.shiftId === s.id).sort((a, b) => a.order - b.order);
---

<Layout title={s.title} section="Shift archive"
  ><a href="/shifts/" class="back-link">← Shift archive</a><div class="reading-heading">
    <span class="eyebrow">{dateLabel(s.date)} · {s.processing} ARCHIVE</span><h1>{s.title}</h1><p
      class="lead"
    >
      {s.summary}
    </p><div class="notice">
      Recording offsets are relative to each file. Gaps between voice-activated recordings are
      unknown; audio duration is not elapsed shift time.
    </div>
  </div><div class="archive-layout">
    <aside class="archive-index">
      <span class="eyebrow">IN THIS SHIFT</span><nav aria-label="Shift discussions">
        {
          ds.map((d, i) => (
            <a href={`#${d.id}`}>
              <span>{String(i + 1).padStart(2, '0')}</span>
              {d.title}
            </a>
          ))
        }
      </nav><details>
        <summary>Recording metadata</summary>{
          s.recordings.map((r) => (
            <p>
              <br />
              {offset(r.durationSeconds)} audio · {r.capturedAt ?? 'Clock unknown'}
              <br />
              {r.clockConfidence}
            </p>
          ))
        }<small>Timezone: {s.timezone}</small>
      </details>
    </aside><div>{ds.map((d) => <Discussion discussion={d} library={lib} />)}</div>
  </div></Layout
>
