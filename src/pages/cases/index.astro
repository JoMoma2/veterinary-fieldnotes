---
import Layout from '../../layouts/Layout.astro';
import Tags from '../../components/Tags.astro';
import Empty from '../../components/Empty.astro';
import { getLibrary } from '../../lib/library';
const lib = await getLibrary();
---

<Layout title="Clinical cases" section="Clinical cases">
  <div class="page-heading">
    <div>
      <span class="eyebrow">THE DETAILS BEHIND THE LESSONS</span>
      <h1>Clinical cases</h1>
      <p>What was reported. What was observed. What we still don’t know.</p>
    </div>
    <span class="count-badge">{lib.cases.length} cases</span>
  </div>
  {lib.cases.length ? (
    <div class="case-grid">
      {lib.cases.map((c) => (
        <article class="case-card">
          <span class="eyebrow">{c.patientLabel}</span>
          <h2>
            <a href={`/cases/${c.id}/`}>{c.title}</a>
          </h2>
          <p>{c.summary}</p>
          <Tags ids={c.topics} topics={lib.topics} />
          <dl class="case-status">
            <div>
              <dt>Diagnosis</dt>
              <dd>{c.diagnosis ?? 'Unknown'}</dd>
            </div>
            <div>
              <dt>Outcome</dt>
              <dd>{c.outcome ?? 'Unknown'}</dd>
            </div>
          </dl>
          <a class="text-link" href={`/cases/${c.id}/`}>
            Explore {c.sourceDiscussionIds.length} source discussions →
          </a>
        </article>
      ))}
    </div>
  ) : (
    <Empty
      title="Clinical stories, carefully preserved"
      message="No cases have been approved for publication. Private processing can continue independently of public review."
      icon="case"
    />
  )}
</Layout>
