---
import { labels } from '../lib/format';
import type { Fact } from '../lib/schemas';
const { facts } = Astro.props as { facts: Fact[] };
---

<div class="facts">
  {facts.map((f) => (
    <div class:list={['fact', { 'fact-unknown': f.kind === 'unknown' }]}>
      <span class="evidence-label">{labels[f.kind]}</span>
      <p>{f.text}</p>
      {f.externalUrl && (
        <a href={f.externalUrl} rel="noreferrer">
          External reference ↗
        </a>
      )}
    </div>
  ))}
</div>
