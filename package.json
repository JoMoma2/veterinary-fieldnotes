{
  "name": "veterinary-fieldnotes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check && tsx scripts/validate.ts",
    "schemas": "tsx scripts/export-schemas.ts",
    "test": "tsx --test tests/*.test.ts",
    "build": "tsx scripts/validate.ts && astro build && pagefind --site dist && tsx scripts/check-build.ts",
    "preview": "astro preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "demo": "LIBRARY_DATASET=demo astro dev --host 127.0.0.1",
    "demo:pipeline": "uv run --project pipeline python scripts/demo-workflow.py",
    "deploy": "node scripts/deploy-cloudflare.mjs",
    "format": "prettier --write src scripts/*.ts scripts/*.mjs tests *.ts *.mjs"
  },
  "dependencies": {
    "astro": "7.4.4",
    "gray-matter": "^4.0.3",
    "marked": "^17.0.0",
    "sanitize-html": "^2.17.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.0",
    "cheerio": "^1.1.2",
    "pagefind": "1.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
