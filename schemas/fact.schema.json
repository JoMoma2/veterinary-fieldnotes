{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "direct-observation",
        "owner-report",
        "clinical-suspicion",
        "confirmed-diagnosis",
        "actual-treatment",
        "proposed-treatment",
        "outcome",
        "ai-explanation",
        "externally-verified",
        "unknown"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "sourceDiscussionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      }
    },
    "externalUrl": {
      "type": "string",
      "pattern": "^https?:\\/\\/"
    }
  },
  "required": [
    "kind",
    "text",
    "sourceDiscussionIds"
  ],
  "additionalProperties": false
}
