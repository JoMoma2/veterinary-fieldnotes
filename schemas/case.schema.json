{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "origin": {
      "type": "string",
      "enum": [
        "synthetic",
        "authorized-record"
      ]
    },
    "publication": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved",
            "withheld"
          ]
        },
        "audience": {
          "type": "string",
          "enum": [
            "private",
            "public"
          ]
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "authorizationRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "audience"
      ],
      "additionalProperties": false
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "topics": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      }
    },
    "species": {
      "type": "string",
      "minLength": 1
    },
    "patientLabel": {
      "type": "string",
      "minLength": 1
    },
    "diagnosis": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceDiscussionIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      }
    },
    "facts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "direct-observation",
              "owner-report",
              "clinical-suspicion",
              "confirmed-diagnosis",
              "actual-treatment",
              "proposed-treatment",
              "outcome",
              "ai-explanation",
              "externally-verified",
              "unknown"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "sourceDiscussionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            }
          },
          "externalUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "kind",
          "text",
          "sourceDiscussionIds"
        ],
        "additionalProperties": false
      }
    },
    "linkBasis": {
      "type": "string",
      "minLength": 1
    },
    "uncertainties": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "origin",
    "publication",
    "title",
    "summary",
    "topics",
    "species",
    "patientLabel",
    "diagnosis",
    "outcome",
    "sourceDiscussionIds",
    "facts",
    "linkBasis",
    "uncertainties"
  ],
  "additionalProperties": false
}
