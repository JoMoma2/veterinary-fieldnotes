{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "color": {
      "type": "string",
      "enum": [
        "green",
        "amber",
        "blue",
        "rose"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "color"
  ],
  "additionalProperties": false
}
